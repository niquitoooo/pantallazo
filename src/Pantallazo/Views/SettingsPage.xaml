<UserControl x:Class="Pantallazo.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m3="clr-namespace:Pantallazo.Theming">
    <UserControl.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource M3.TitleMedium}">
            <Setter Property="Margin" Value="4,24,0,10" />
            <Setter Property="Foreground" Value="{DynamicResource M3.Primary}" />
        </Style>
        <Style x:Key="RowText" TargetType="TextBlock" BasedOn="{StaticResource M3.BodyLarge}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Padding="28,24,28,28">
        <StackPanel MaxWidth="900">
            <TextBlock Style="{StaticResource M3.HeadlineSmall}" Text="Configuración" />

            <!-- Atajos -->
            <TextBlock x:Name="ShortcutsTitle" Style="{StaticResource SectionTitle}" Text="Atajos de teclado" />
            <Border Style="{StaticResource M3.Card}" Padding="20">
                <StackPanel>
                    <TextBlock Style="{StaticResource M3.BodySmall}" Margin="0,0,0,12" TextWrapping="Wrap"
                               Text="Hacé clic en un atajo y presioná la combinación nueva. Esc lo deja sin asignar. Los atajos funcionan aunque la ventana esté cerrada o minimizada." />
                    <StackPanel x:Name="HotkeyRows" />
                    <Border x:Name="ConflictBanner" CornerRadius="8" Background="{DynamicResource M3.ErrorContainer}" Padding="12,8" Margin="0,8,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="ConflictText" Style="{StaticResource M3.BodyMedium}" Foreground="{DynamicResource M3.OnErrorContainer}" />
                    </Border>
                    <Border Style="{StaticResource M3.Divider}" Margin="0,10,0,0" />
                    <DockPanel Margin="0,12,0,0">
                        <ToggleButton x:Name="PausePrintScreenSwitch" DockPanel.Dock="Right" Style="{StaticResource M3.Switch}" VerticalAlignment="Center"
                                      AutomationProperties.Name="Pausar Impr Pant" Click="OnPausePrintScreen" />
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource M3.BodyLarge}" Text="Pausar Impr Pant" />
                            <TextBlock Style="{StaticResource M3.BodySmall}" TextWrapping="Wrap" Margin="0,2,0,0"
                                       Text="Pantallazo deja de usar Impr Pant (sola, con Ctrl o con Alt) y Windows la usa como siempre: Impr Pant abre Recortes. Sigue en pausa hasta que la reactives, aunque reinicies." />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Margin="0,16,0,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource M3.OutlinedButton}" Content="Restaurar predeterminados"
                                m3:M3.Icon="{x:Static m3:Icons.Undo}" Click="OnResetHotkeys" VerticalAlignment="Top" />
                        <StackPanel>
                            <TextBlock x:Name="SnippingText" Style="{StaticResource M3.BodyMedium}" TextWrapping="Wrap" Margin="0,0,16,6" />
                            <Button x:Name="SnippingButton" Style="{StaticResource M3.TextButton}" Click="OnToggleSnipping" Padding="0,0" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Carpetas -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="Carpetas de destino" />
            <Border Style="{StaticResource M3.Card}" Padding="20,12">
                <StackPanel>
                    <DockPanel Margin="0,6">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource M3.IconButton}" m3:M3.Icon="{x:Static m3:Icons.Undo}" ToolTip="Volver a la carpeta predeterminada" Click="OnResetShotsFolder" />
                            <Button Style="{StaticResource M3.TextButton}" Content="Cambiar" Click="OnChangeShotsFolder" />
                            <Button Style="{StaticResource M3.TonalButton}" Content="Abrir" m3:M3.Icon="{x:Static m3:Icons.Folder}" Padding="16,0" Click="OnOpenShotsFolder" />
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource M3.Icon}" Text="{x:Static m3:Icons.Image}" Margin="0,0,16,0" Foreground="{DynamicResource M3.OnSurfaceVariant}" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource M3.BodyLarge}" Text="Capturas de pantalla" />
                            <TextBlock x:Name="ShotsFolder" Style="{StaticResource M3.BodySmall}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,2,12,0" />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource M3.Divider}" Margin="0,6" />
                    <DockPanel Margin="0,6">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource M3.IconButton}" m3:M3.Icon="{x:Static m3:Icons.Undo}" ToolTip="Volver a la carpeta predeterminada" Click="OnResetVideosFolder" />
                            <Button Style="{StaticResource M3.TextButton}" Content="Cambiar" Click="OnChangeVideosFolder" />
                            <Button Style="{StaticResource M3.TonalButton}" Content="Abrir" m3:M3.Icon="{x:Static m3:Icons.Folder}" Padding="16,0" Click="OnOpenVideosFolder" />
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource M3.Icon}" Text="{x:Static m3:Icons.Video}" Margin="0,0,16,0" Foreground="{DynamicResource M3.OnSurfaceVariant}" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource M3.BodyLarge}" Text="Grabaciones de video" />
                            <TextBlock x:Name="VideosFolder" Style="{StaticResource M3.BodySmall}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,2,12,0" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Nombres de archivo -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="Nombres de archivo" />
            <Border Style="{StaticResource M3.Card}" Padding="20">
                <StackPanel>
                    <TextBlock Style="{StaticResource M3.BodyMedium}" Foreground="{DynamicResource M3.OnSurfaceVariant}" TextWrapping="Wrap" Margin="0,0,0,16"
                               Text="Escribí cómo querés que se llamen los archivos. Las etiquetas entre llaves se reemplazan al guardar y la extensión se agrega sola." />
                    <TextBlock Style="{StaticResource M3.LabelLarge}" Text="Capturas de pantalla" Margin="0,0,0,6" />
                    <TextBox x:Name="ShotTemplate" Style="{StaticResource M3.TextBox}" AutomationProperties.Name="Plantilla de capturas"
                             TextChanged="OnTemplateChanged" GotKeyboardFocus="OnTemplateFocus" />
                    <TextBlock x:Name="ShotExample" Style="{StaticResource M3.BodySmall}" Margin="4,6,0,16" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource M3.LabelLarge}" Text="Grabaciones de video" Margin="0,0,0,6" />
                    <TextBox x:Name="VideoTemplate" Style="{StaticResource M3.TextBox}" AutomationProperties.Name="Plantilla de grabaciones"
                             TextChanged="OnTemplateChanged" GotKeyboardFocus="OnTemplateFocus" />
                    <TextBlock x:Name="VideoExample" Style="{StaticResource M3.BodySmall}" Margin="4,6,0,16" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource M3.LabelLarge}" Text="Etiquetas: tocá una para agregarla donde está el cursor" Margin="0,0,0,8" />
                    <WrapPanel x:Name="TagChips" />
                    <Button Style="{StaticResource M3.TextButton}" Content="Volver a los nombres predeterminados" m3:M3.Icon="{x:Static m3:Icons.Undo}"
                            HorizontalAlignment="Left" Margin="0,8,0,0" Click="OnResetTemplates" />
                </StackPanel>
            </Border>

            <!-- Apariencia -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="Apariencia" />
            <Border Style="{StaticResource M3.Card}" Padding="20">
                <StackPanel>
                    <TextBlock Style="{StaticResource M3.LabelLarge}" Text="Tema" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <RadioButton x:Name="ThemeSystem" Style="{StaticResource M3.Segment}" m3:M3.Segment="First" GroupName="theme" Content="Del sistema" Checked="OnTheme" />
                        <RadioButton x:Name="ThemeLight" Style="{StaticResource M3.Segment}" GroupName="theme" Content="Claro" Checked="OnTheme" />
                        <RadioButton x:Name="ThemeDark" Style="{StaticResource M3.Segment}" m3:M3.Segment="Last" GroupName="theme" Content="Oscuro" Checked="OnTheme" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource M3.LabelLarge}" Text="Color" Margin="0,0,0,10" />
                    <WrapPanel x:Name="Swatches" />
                </StackPanel>
            </Border>

            <!-- Captura -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="Opciones de captura" />
            <Border Style="{StaticResource M3.Card}" Padding="20,8">
                <StackPanel x:Name="CaptureOptions" />
            </Border>

            <!-- Calidad de grabación -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="Calidad de grabación" />
            <Border Style="{StaticResource M3.Card}" Padding="20">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource M3.TonalButton}" Content="Abrir Grabación" Click="OnOpenRecordPage" VerticalAlignment="Center" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="QualitySummary" Style="{StaticResource M3.BodyLarge}" />
                        <TextBlock Style="{StaticResource M3.BodySmall}" Margin="0,2,12,0" Text="Los cuadros por segundo, la calidad, la pantalla y el audio se eligen en la sección Grabación." />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Inicio y segundo plano -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="Inicio y segundo plano" />
            <Border Style="{StaticResource M3.Card}" Padding="20,8">
                <StackPanel x:Name="BehaviorOptions" />
            </Border>

            <!-- Acerca de -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="Acerca de" />
            <Border Style="{StaticResource M3.Card}" Padding="20">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource M3.TextButton}" Content="Abrir registros" Click="OnOpenLogs" VerticalAlignment="Center" />
                    <StackPanel>
                        <TextBlock x:Name="AboutText" Style="{StaticResource M3.BodyLarge}" />
                        <TextBlock Style="{StaticResource M3.BodySmall}" Margin="0,2,12,0" TextWrapping="Wrap"
                                   Text="Funciona sin Internet y no envía datos a ningún lado. Los registros quedan solo en este equipo (14 días)." />
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
