<UserControl x:Class="Pantallazo.Views.RecordPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m3="clr-namespace:Pantallazo.Theming">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,24,28,24">
        <StackPanel MaxWidth="900">
            <TextBlock Style="{StaticResource M3.HeadlineSmall}" Text="Grabación" />
            <TextBlock x:Name="StatusText" Style="{StaticResource M3.BodyMedium}" Margin="0,6,0,18"
                       Foreground="{DynamicResource M3.OnSurfaceVariant}" />

            <!-- Control principal -->
            <Border Style="{StaticResource M3.Card}" Margin="0,0,0,16" Padding="20">
                <DockPanel>
                    <Button x:Name="StartStopButton" DockPanel.Dock="Right" Style="{StaticResource M3.FilledButton}" Height="48" Padding="28,0"
                            Content="Iniciar grabación" m3:M3.Icon="{x:Static m3:Icons.Record}" Click="OnStartStop" VerticalAlignment="Center" />
                    <Button x:Name="PauseButton" DockPanel.Dock="Right" Style="{StaticResource M3.TonalButton}" Height="48" Padding="24,0" Margin="0,0,8,0"
                            Content="Pausar" m3:M3.Icon="{x:Static m3:Icons.Pause}" Click="OnPause" VerticalAlignment="Center" Visibility="Collapsed" />
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="RecDot" Width="10" Height="10" Fill="{DynamicResource M3.Error}" Margin="0,0,10,0" Visibility="Collapsed" />
                            <TextBlock x:Name="Elapsed" Style="{StaticResource M3.TitleLarge}" Text="00:00" FontFamily="Cascadia Mono, Consolas" />
                        </StackPanel>
                        <TextBlock x:Name="HintText" Style="{StaticResource M3.BodySmall}" Margin="0,4,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Qué grabar -->
            <Border Style="{StaticResource M3.Card}" Margin="0,0,0,16" Padding="20">
                <StackPanel>
                    <TextBlock Style="{StaticResource M3.TitleMedium}" Text="Qué grabar" Margin="0,0,0,12" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="TargetAll" Style="{StaticResource M3.Segment}" m3:M3.Segment="First" GroupName="target"
                                     m3:M3.Icon="{x:Static m3:Icons.FullScreen}" Content="Todas las pantallas" Checked="OnTarget" />
                        <RadioButton x:Name="TargetDisplay" Style="{StaticResource M3.Segment}" GroupName="target"
                                     m3:M3.Icon="{x:Static m3:Icons.Display}" Content="Una pantalla" Checked="OnTarget" />
                        <RadioButton x:Name="TargetRegion" Style="{StaticResource M3.Segment}" m3:M3.Segment="Last" GroupName="target"
                                     m3:M3.Icon="{x:Static m3:Icons.Region}" Content="Región fija" Checked="OnTarget" />
                    </StackPanel>
                    <ComboBox x:Name="DisplayCombo" Style="{StaticResource M3.ComboBox}" Margin="0,14,0,0" MaxWidth="460" HorizontalAlignment="Left"
                              MinWidth="320" DisplayMemberPath="Label" SelectionChanged="OnDisplayChanged" Visibility="Collapsed" />
                    <DockPanel x:Name="RegionRow" Margin="0,14,0,0" Visibility="Collapsed">
                        <Button DockPanel.Dock="Left" Style="{StaticResource M3.TonalButton}" Content="Elegir región" m3:M3.Icon="{x:Static m3:Icons.Region}"
                                Click="OnPickRegion" Margin="0,0,14,0" />
                        <TextBlock x:Name="RegionText" Style="{StaticResource M3.BodyMedium}" VerticalAlignment="Center" Foreground="{DynamicResource M3.OnSurfaceVariant}" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Audio -->
            <Border Style="{StaticResource M3.Card}" Margin="0,0,0,16" Padding="20">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Style="{StaticResource M3.IconButton}" m3:M3.Icon="{x:Static m3:Icons.Refresh}"
                                ToolTip="Volver a buscar dispositivos" Click="OnRefreshDevices" />
                        <TextBlock Style="{StaticResource M3.TitleMedium}" Text="Audio de la grabación" VerticalAlignment="Center" />
                    </DockPanel>
                    <WrapPanel>
                        <RadioButton x:Name="AudioSystem" Style="{StaticResource M3.Segment}" m3:M3.Segment="First" GroupName="audio"
                                     Content="Audio del sistema" Checked="OnAudioMode" />
                        <RadioButton x:Name="AudioMic" Style="{StaticResource M3.Segment}" GroupName="audio" Content="Micrófono" Checked="OnAudioMode" />
                        <RadioButton x:Name="AudioBoth" Style="{StaticResource M3.Segment}" GroupName="audio" Content="Sistema + micrófonos" Checked="OnAudioMode" />
                        <RadioButton x:Name="AudioNone" Style="{StaticResource M3.Segment}" m3:M3.Segment="Last" GroupName="audio" Content="Sin audio" Checked="OnAudioMode" />
                    </WrapPanel>

                    <!-- Sistema -->
                    <Grid x:Name="SystemRow" Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="52" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource M3.Icon}" Text="{x:Static m3:Icons.Speaker}" Foreground="{DynamicResource M3.OnSurfaceVariant}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,16,0">
                            <TextBlock Style="{StaticResource M3.BodyLarge}" Text="Audio del sistema" />
                            <TextBlock x:Name="OutputName" Style="{StaticResource M3.BodySmall}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            <ProgressBar x:Name="SystemMeter" Style="{StaticResource M3.LinearProgress}" Margin="0,8,0,0" />
                        </StackPanel>
                        <Slider x:Name="SystemVolume" Grid.Column="2" Style="{StaticResource M3.Slider}" Minimum="0" Maximum="2" VerticalAlignment="Center"
                                SmallChange="0.05" LargeChange="0.1" ValueChanged="OnSystemVolume" ToolTip="Volumen de grabación del audio del sistema" />
                        <TextBlock x:Name="SystemVolumeText" Grid.Column="3" Style="{StaticResource M3.LabelMedium}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>

                    <!-- Micrófonos -->
                    <StackPanel x:Name="MicSection" Margin="0,14,0,0">
                        <TextBlock x:Name="NoMicsText" Style="{StaticResource M3.BodyMedium}" Foreground="{DynamicResource M3.OnSurfaceVariant}"
                                   Text="No se encontró ningún micrófono conectado." Margin="44,6,0,0" Visibility="Collapsed" />
                        <ItemsControl x:Name="MicList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,6,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="52" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Style="{StaticResource M3.CheckBox}" IsChecked="{Binding Enabled}" VerticalAlignment="Center" ToolTip="Grabar este micrófono" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,16,0">
                                            <TextBlock Style="{StaticResource M3.BodyLarge}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                            <TextBlock Style="{StaticResource M3.BodySmall}" Text="{Binding Detail}" />
                                            <ProgressBar Style="{StaticResource M3.LinearProgress}" Value="{Binding Level, Mode=OneWay}" Margin="0,8,0,0" />
                                        </StackPanel>
                                        <Slider Grid.Column="2" Style="{StaticResource M3.Slider}" Minimum="0" Maximum="2" Value="{Binding Volume}" VerticalAlignment="Center"
                                                SmallChange="0.05" LargeChange="0.1" IsEnabled="{Binding Enabled}" ToolTip="Volumen de grabación de este micrófono" />
                                        <TextBlock Grid.Column="3" Style="{StaticResource M3.LabelMedium}" Text="{Binding VolumeText}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <TextBlock x:Name="AudioNote" Style="{StaticResource M3.BodySmall}" Margin="0,12,0,0" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <!-- Video -->
            <Border Style="{StaticResource M3.Card}" Margin="0,0,0,16" Padding="20">
                <StackPanel>
                    <TextBlock Style="{StaticResource M3.TitleMedium}" Text="Video" Margin="0,0,0,12" />
                    <TextBlock Style="{StaticResource M3.LabelLarge}" Text="Resolución" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <RadioButton x:Name="ResOriginal" Style="{StaticResource M3.Segment}" m3:M3.Segment="First" GroupName="res" Content="Original" Checked="OnResolution" />
                        <RadioButton x:Name="Res1080" Style="{StaticResource M3.Segment}" GroupName="res" Content="1080p" Checked="OnResolution" />
                        <RadioButton x:Name="Res720" Style="{StaticResource M3.Segment}" m3:M3.Segment="Last" GroupName="res" Content="720p" Checked="OnResolution" />
                    </StackPanel>
                    <TextBlock x:Name="ResolutionHint" Style="{StaticResource M3.BodySmall}" Margin="0,0,0,16" />
                    <TextBlock Style="{StaticResource M3.LabelLarge}" Text="Cuadros por segundo" Margin="0,0,0,8" />
                    <StackPanel x:Name="FpsPanel" Orientation="Horizontal" Margin="0,0,0,6" />
                    <TextBlock x:Name="FpsHint" Style="{StaticResource M3.BodySmall}" Margin="0,0,0,16" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource M3.LabelLarge}" Text="Calidad" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <RadioButton x:Name="QLow" Style="{StaticResource M3.Segment}" m3:M3.Segment="First" GroupName="q" Content="Liviana" Checked="OnQuality"
                                     ToolTip="Archivos más chicos" />
                        <RadioButton x:Name="QBalanced" Style="{StaticResource M3.Segment}" GroupName="q" Content="Equilibrada" Checked="OnQuality" />
                        <RadioButton x:Name="QHigh" Style="{StaticResource M3.Segment}" m3:M3.Segment="Last" GroupName="q" Content="Alta" Checked="OnQuality"
                                     ToolTip="Más nitidez en movimiento, archivos más grandes" />
                    </StackPanel>
                    <DockPanel>
                        <ToggleButton x:Name="CursorSwitch" DockPanel.Dock="Right" Style="{StaticResource M3.Switch}" Click="OnCursorSwitch" />
                        <TextBlock Style="{StaticResource M3.BodyLarge}" Text="Grabar el puntero del mouse" VerticalAlignment="Center" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Carpeta -->
            <Border Style="{StaticResource M3.Card}" Padding="20">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource M3.TextButton}" Content="Cambiar" Click="OnChangeFolder" />
                        <Button Style="{StaticResource M3.TonalButton}" Content="Abrir" m3:M3.Icon="{x:Static m3:Icons.Folder}" Padding="16,0" Click="OnOpenFolder" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Style="{StaticResource M3.TitleMedium}" Text="Carpeta de destino" />
                        <TextBlock x:Name="FolderText" Style="{StaticResource M3.BodySmall}" Margin="0,4,12,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
