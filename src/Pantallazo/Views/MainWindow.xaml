<Window x:Class="Pantallazo.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m3="clr-namespace:Pantallazo.Theming"
        Title="Pantallazo"
        Width="980" Height="680" MinWidth="720" MinHeight="520"
        Background="{DynamicResource M3.Surface}"
        FontFamily="{StaticResource M3.Font}"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">
    <!-- Barra de título propia de 48 como las apps de Windows 11; el marco (sombra, esquinas, bordes para
         estirar) lo sigue dibujando Windows. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barra de título -->
        <Grid x:Name="TitleBar">
            <StackPanel x:Name="TitleContent" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <Image x:Name="TitleIcon" Width="16" Height="16" />
                <TextBlock Text="Pantallazo" FontSize="12" Margin="12,0,0,1" VerticalAlignment="Center"
                           Foreground="{DynamicResource M3.OnSurface}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button x:Name="MinButton" Style="{StaticResource M3.CaptionButton}" m3:M3.Icon="{x:Static m3:Icons.ChromeMinimize}"
                        Click="OnMinimize" AutomationProperties.Name="Minimizar" />
                <Button x:Name="MaxButton" Style="{StaticResource M3.CaptionButton}" m3:M3.Icon="{x:Static m3:Icons.ChromeMaximize}"
                        Click="OnMaximize" AutomationProperties.Name="Maximizar" />
                <Button x:Name="CloseButton" Style="{StaticResource M3.CaptionCloseButton}" m3:M3.Icon="{x:Static m3:Icons.ChromeClose}"
                        Click="OnCloseButton" AutomationProperties.Name="Cerrar" />
            </StackPanel>
        </Grid>

    <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Riel de navegación M3 -->
        <DockPanel Width="96" Margin="0,0,0,12">
            <Border DockPanel.Dock="Top" Width="56" Height="56" CornerRadius="16" Margin="0,4,0,28"
                    Background="{DynamicResource M3.PrimaryContainer}" ToolTip="Pantallazo">
                <TextBlock Style="{StaticResource M3.Icon}" Text="{x:Static m3:Icons.Camera}" FontSize="22"
                           Foreground="{DynamicResource M3.OnPrimaryContainer}" />
            </Border>
            <StackPanel>
                <RadioButton x:Name="NavHome" Style="{StaticResource M3.NavItem}" m3:M3.Icon="{x:Static m3:Icons.Home}"
                             Content="Inicio" IsChecked="True" Checked="OnNav" GroupName="nav" />
                <RadioButton x:Name="NavRecord" Style="{StaticResource M3.NavItem}" m3:M3.Icon="{x:Static m3:Icons.Video}"
                             Content="Grabación" Checked="OnNav" GroupName="nav" />
                <RadioButton x:Name="NavSettings" Style="{StaticResource M3.NavItem}" m3:M3.Icon="{x:Static m3:Icons.Settings}"
                             Content="Configuración" Checked="OnNav" GroupName="nav" />
            </StackPanel>
        </DockPanel>

        <!-- Contenido -->
        <Border Grid.Column="1" Margin="0,0,12,12" CornerRadius="24" Background="{DynamicResource M3.SurfaceContainerLow}">
            <ContentControl x:Name="PageHost" Focusable="False" />
        </Border>
    </Grid>
    </Grid>
</Window>
