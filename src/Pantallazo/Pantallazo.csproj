<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Pantallazo</RootNamespace>
    <AssemblyName>Pantallazo</AssemblyName>
    <Version>1.1.0</Version>
    <Product>Pantallazo</Product>
    <Description>Capturas y grabación de pantalla</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\pantallazo.ico</ApplicationIcon>
    <StartupObject>Pantallazo.Program</StartupObject>
    <SatelliteResourceLanguages>es</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- Main propio (Program.cs): instancia única, sondeo del encoder y autoprueba -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
    <Resource Include="Assets\pantallazo.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pantallazo.Recording\Pantallazo.Recording.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pantallazo.Tests" />
  </ItemGroup>

</Project>
